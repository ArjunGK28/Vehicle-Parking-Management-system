{
  "name": "vehicle-parking-management-system",
  "version": "0.1.0",
  "private": true,
  "description": "Vehicle Parking Management and Tracking System",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "db:init": "npm run db:init -w server",
    "db:reset": "npm run db:reset -w server",
    "db:seed": "npm run db:seed -w server",
    "build": "npm run build -w client",
    "test": "jest --runInBand",
    "e2e:install": "playwright install firefox",
    "e2e": "npm run build && playwright test",
    "e2e:report": "playwright show-report"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  }
}