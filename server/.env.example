# Copy this file to server/.env and adjust if needed.
# These match database/setup-dev.sql (local development only).
PORT=4000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=parking_app
DB_PASSWORD=parking_dev_pw
DB_NAME=parking_dev
printf '\n# Minutes an account stays locked after 5 failed logins (default 15)\nLOCKOUT_MINUTES=15\n' >> server/.env.example